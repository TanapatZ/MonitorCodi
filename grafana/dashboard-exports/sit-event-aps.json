  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cg46fq5i2i48wf"
      },
      "description": "Controller SNMP scrape health. A failure means AP data cannot be refreshed.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "UNREACHABLE"
                },
                "1": {
                  "color": "green",
                  "text": "OK"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cg46fq5i2i48wf"
          },
          "expr": "up{job=\"snmp_aps\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Controller SNMP",
      "type": "stat"
    },
    {
