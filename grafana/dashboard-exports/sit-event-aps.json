    {
      "datasource": {
        "type": "prometheus",
        "uid": "cg46fq5i2i48wf"
      },
      "description": "Signal health uses SNR only: 0–20 dB Poor, 21–35 Fair, 36+ Good. It is not the Aruba controller health score. Missing SNR is unknown.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Signal health"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "from": 0,
                      "result": {
                        "color": "red",
                        "index": 0,
                        "text": "Poor"
                      },
                      "to": 20
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "from": 21,
                      "result": {
                        "color": "orange",
                        "index": 1,
                        "text": "Fair"
                      },
                      "to": 35
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "from": 36,
                      "result": {
                        "color": "green",
                        "index": 2,
                        "text": "Good"
                      },
                      "to": 200
                    },
                    "type": "range"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SNR (dB)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dB"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "id": 18,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Data since session began"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cg46fq5i2i48wf"
          },
          "expr": "(clientSessionInfo{job=\"aruba_event_clients\"} * 0) + on(instance,clientMac,clientIp) group_left() (clientRxBytes{job=\"aruba_event_clients\"} + clientTxBytes{job=\"aruba_event_clients\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Connected clients: AP and session data",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "apBSSID": true,
              "instance": true,
              "job": true,
              "name": true,
              "role": true,
              "site": true
            },
            "renameByName": {
              "Value": "Data since session began",
              "apLocation": "AP",
              "clientIp": "IP",
              "clientMac": "MAC",
              "clientName": "Client",
              "signalSNR": "SNR (dB)",
              "ssid": "SSID"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "number",
                "targetField": "SNR (dB)"
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Signal health",
            "binary": {
              "left": "SNR (dB)",
              "operator": "+",
              "right": "0"
            },
            "mode": "binary"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "AP": 0,
              "Client": 1,
              "Data since session began": 6,
              "IP": 2,
              "MAC": 7,
              "SNR (dB)": 4,
              "SSID": 3,
              "Signal health": 5
            }
          }
        }
      ],
      "type": "table"
    },
