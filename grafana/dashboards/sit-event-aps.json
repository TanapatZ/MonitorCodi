{
  "uid": "sit-event-aps",
  "title": "SIT Event APs (Aruba controller)",
  "tags": [
    "network",
    "ap",
    "snmp",
    "aruba",
    "sit event"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Controller SNMP",
      "description": "Controller SNMP scrape health. A failure means AP data cannot be refreshed.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"aruba_controller\"}",
          "legendFormat": "",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNREACHABLE",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "APs online",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(wlanAPStatus{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"} == bool 1)",
          "legendFormat": "",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "APs offline",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(wlanAPStatus{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"} == bool 2)",
          "legendFormat": "",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "APs in SIT-Event",
      "description": "Group membership comes directly from the controller.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(wlanAPStatus{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"})",
          "legendFormat": "",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Associated clients",
      "description": "Clients associated with radios on APs in this group.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(wlanAPRadioNumAssociatedClients{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"})",
          "legendFormat": "",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Current BSSID bandwidth",
      "description": "Sum of the controller-reported BSSID bandwidth gauges; not link capacity.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(wlanAPFrameBandwidthRate{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}) * 1000",
          "legendFormat": "",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "AP status (controller)",
      "description": "1 = up, 2 = down as reported by the controller.",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "wlanAPStatus{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}",
          "legendFormat": "{{wlanAPName}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "2": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true
      }
    },
    {
      "id": 8,
      "title": "Clients by AP",
      "description": "Sum of associated clients across each AP radio.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (wlanAPName) (wlanAPRadioNumAssociatedClients{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"})",
          "legendFormat": "{{wlanAPName}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Radio utilization",
      "description": "Controller-reported radio utilization, 0\u2013100%.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "wlanAPRadioUtilization{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}",
          "legendFormat": "{{wlanAPName}} / radio {{wlanAPRadioNumber}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "AP receive traffic",
      "description": "BSSID data bytes received by the AP; summed across BSSIDs and radios.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (wlanAPName) (rate(wlanAPRxDataBytes64{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}[5m])) * 8",
          "legendFormat": "{{wlanAPName}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "AP transmit traffic",
      "description": "BSSID data bytes transmitted by the AP; summed across BSSIDs and radios.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (wlanAPName) (rate(wlanAPTxDataBytes64{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}[5m])) * 8",
          "legendFormat": "{{wlanAPName}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "AP uptime since controller bootstrap",
      "description": "",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "wlanAPUpTime{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"} / 100",
          "legendFormat": "{{wlanAPName}}",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "BSSID bandwidth by AP",
      "description": "Sum of the BSSID bandwidth gauges; units converted from Kbps to bps.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (wlanAPName) (wlanAPFrameBandwidthRate{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}) * 1000",
          "legendFormat": "{{wlanAPName}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Wi-Fi retry rate by AP and BSSID",
      "description": "Controller-reported percentage of retries for each BSSID.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "wlanAPFrameRetryRate{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}",
          "legendFormat": "{{wlanAPName}} / {{wlanAPBSSID}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "AP switch port status (LLDP)",
      "description": "Live LLDP neighbors matched by AP name. A disconnected AP may disappear from this panel; use AP status above for offline devices.",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "ifOperStatus{job=\"event_ap_switches\"} * on(instance,ifName) group_left(lldpRemSysName) label_replace(lldpRemSysName{job=\"event_ap_switches\"}, \"ifName\", \"$1\", \"lldpLocPortId\", \"(.*)\") and on(lldpRemSysName) label_replace(wlanAPStatus{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}, \"lldpRemSysName\", \"$1\", \"wlanAPName\", \"(.*)\")",
          "legendFormat": "{{lldpRemSysName}} / {{name}} port {{ifName}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "2": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true
      }
    },
    {
      "id": 16,
      "title": "AP PoE detection status (LLDP)",
      "description": "POWER-ETHERNET-MIB group 1 port number matched to LLDP local port. Only current LLDP neighbors are shown; an offline AP can disappear.",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "label_replace(pethPsePortDetectionStatus{job=\"event_ap_switches\",pethPsePortGroupIndex=\"1\"}, \"ifName\", \"$1\", \"pethPsePortIndex\", \"(.*)\") * on(instance,ifName) group_left(lldpRemSysName) label_replace(lldpRemSysName{job=\"event_ap_switches\"}, \"ifName\", \"$1\", \"lldpLocPortId\", \"(.*)\") and on(lldpRemSysName) label_replace(wlanAPStatus{job=\"aruba_controller\",wlanAPGroupName=\"SIT-Event\"}, \"lldpRemSysName\", \"$1\", \"wlanAPName\", \"(.*)\")",
          "legendFormat": "{{lldpRemSysName}} / {{name}} port {{ifName}}",
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Disabled",
                  "color": "gray"
                },
                "2": {
                  "text": "Searching",
                  "color": "orange"
                },
                "3": {
                  "text": "Delivering power",
                  "color": "green"
                },
                "4": {
                  "text": "Fault",
                  "color": "red"
                },
                "5": {
                  "text": "Test",
                  "color": "orange"
                },
                "6": {
                  "text": "Other fault",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 3
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Connected clients: AP and session data",
      "description": "Signal health uses SNR only: 0\u201320 dB Poor, 21\u201335 Fair, 36+ Good. It is not the Aruba controller health score. Missing SNR is unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(clientSessionInfo{job=\"aruba_event_clients\"} * 0) + on(instance,clientMac,clientIp) group_left() (clientRxBytes{job=\"aruba_event_clients\"} + clientTxBytes{job=\"aruba_event_clients\"})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "name": true,
              "apBSSID": true,
              "role": true,
              "site": true
            },
            "renameByName": {
              "clientName": "Client",
              "clientIp": "IP",
              "clientMac": "MAC",
              "apLocation": "AP",
              "Value": "Data since session began",
              "ssid": "SSID",
              "signalSNR": "SNR (dB)"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "SNR (dB)",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "SNR (dB)",
              "operator": "+",
              "right": "0"
            },
            "alias": "Signal health"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "AP": 0,
              "Client": 1,
              "IP": 2,
              "SSID": 3,
              "SNR (dB)": 4,
              "Signal health": 5,
              "Data since session began": 6,
              "MAC": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Signal health"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 0,
                      "to": 20,
                      "result": {
                        "text": "Poor",
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 21,
                      "to": 35,
                      "result": {
                        "text": "Fair",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 36,
                      "to": 200,
                      "result": {
                        "text": "Good",
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
