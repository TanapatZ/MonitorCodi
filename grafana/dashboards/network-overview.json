      "targets": [
        {
          "expr": "rate(ifHCOutOctets{job=\"snmp_switches\", ifAlias=~\"(?i).*ndi.*\"}[2m]) * 8 / (ifHighSpeed * 1e6) and ifHighSpeed > 0",
